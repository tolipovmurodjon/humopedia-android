<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ hides other apps unless asked: the shell has to find a browser that can host the web app. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The keypad and the right/wrong sounds buzz the phone through navigator.vibrate. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The no-internet screen tries again by itself when the phone is back online. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".HumoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:manageSpaceActivity="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Humopedia">

        <!-- The site this app may open without a URL bar; the site's assetlinks.json names this app back. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/humo_mint" />

        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <activity android:name="com.google.androidbrowserhelper.trusted.FocusActivity" />

        <!-- The one screen, opened straight from the icon and from links. A launcher activity that handed over to it
             showed the home screen and a second splash for a second (A05s, 2026-10-03). -->
        <activity
            android:name=".WebAppActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="@string/web_host"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- LauncherActivity enables this screen by class name at start-up ("Manage site data" in system settings).
             Undeclared, R8 renamed it and every release build crashed on launch (Play pre-launch report, 2026-10-01). -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.customtabs.trusted.MANAGE_SPACE_URL"
                android:value="@string/launch_url" />
        </activity>

        <!-- Phones with no Custom Tabs browser still get the app, inside a WebView. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false" />

        <!-- Hands the splash image to the browser, which draws it while the page loads. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.mcompany.humo.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>

</manifest>
